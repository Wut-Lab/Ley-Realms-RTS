; Engine configuration file.
config_version=5

[application]

config/name="Ley Realms"
config/description="A fantasy real-time strategy game with procedurally generated worlds."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/quit_on_go_back=false
config/icon="res://icon.png"

[autoload]

GameSettings="*res://scripts/game_settings.gd"
Defs="*res://scripts/defs.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
