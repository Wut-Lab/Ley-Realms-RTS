; Engine configuration file.
config_version=5

[application]

config/name="Ley Realms"
config/description="A fantasy real-time strategy game with procedurally generated worlds."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

GameSettings="*res://scripts/game_settings.gd"
Defs="*res://scripts/defs.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
